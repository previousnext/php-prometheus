{
  "name": "previousnext/php-prometheus",
  "description": "A PHP library for serializing to the prometheus text format.",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Kim Pepper",
      "email": "kim@previousnext.com.au"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "symfony/property-access": "^6.4.32|^7.4.8|^8.0",
    "symfony/serializer": "^6.4.32|^7.4.8|^8.0"
  },
  "require-dev": {
    "drupal/coder": "^9.0",
    "phpspec/prophecy": "^1.26",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5.52"
  },
  "autoload": {
    "psr-4": {"PNX\\Prometheus\\": "src/"}
  },
  "autoload-dev": {
    "psr-4": {"PNX\\Prometheus\\Tests\\": "tests/"}
  },
  "config": {
    "bin-dir": "bin/",
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
